{
  "name": "Container Vulnerability Inspector",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    // Lets Trivy and `docker build` inside the container use the host's Docker (Docker Desktop / WSL2).
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {}
  },
  "containerEnv": {
    "TRIVY_VERSION": "0.75.0",
    "TRIVY_CACHE_DIR": "/home/vscode/.cache/trivy"
  },
  "mounts": [
    // Keep Trivy's vulnerability DB between container rebuilds.
    "source=trivy-cache,target=/home/vscode/.cache/trivy,type=volume"
  ],
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "forwardPorts": [8501],
  "portsAttributes": {
    "8501": { "label": "Streamlit dashboard", "onAutoForward": "openBrowser" }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "charliermarsh.ruff",
        "ms-azuretools.vscode-docker",
        "github.vscode-github-actions",
        "redhat.vscode-yaml"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "python.testing.pytestEnabled": true,
        "python.testing.pytestArgs": ["tests"],
        "[python]": { "editor.defaultFormatter": "charliermarsh.ruff" }
      }
    }
  },
  "remoteUser": "vscode"
}
